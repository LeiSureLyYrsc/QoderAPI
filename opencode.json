{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "Cherry-Amoe": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cherry-Amoe",
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY_AMOE}",
        "baseURL": "https://ai.amoe.cc/v1"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "gpt-5.6-luna",
          "reasoning": true,
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  }
}