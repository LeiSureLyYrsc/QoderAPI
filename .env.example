# CN
QODERCN_PERSONAL_ACCESS_TOKEN=pt-...
# Global
QODER_PERSONAL_ACCESS_TOKEN=pt-...

# cn | global
QODER_REGION=cn

# Optional config root (default ~/.qoder-reserve)
# QODER_RESERVE_CONFIG_DIR=

# OpenAI proxy
# Bind address and port. Use 0.0.0.0 to expose the service beyond localhost.
# HOST=127.0.0.1
# PORT=3927
# PROXY_API_KEY=change-me

# Disable auto browser open for device login
# NO_BROWSER=1

# Docker bind-mount for account pool / machine_id
# DATA_DIR=./data
# PUID=1000
# PGID=1000
# QODER_DEBUG=1
